    "docs/events.md": "# User-created event\n\nThe payload contains `user_name`.\n",
    "tests/test_events.py": "from types import SimpleNamespace\n\nfrom src.events import user_created_event\n\ndef test_user_created_event():\n    event = user_created_event(SimpleNamespace(name='Ada'))\n    assert event['payload']['user_name'] == 'Ada'\n",
    ".env": "TOKEN=redacted-placeholder\n",
    "secrets.md": "# Sensitive fixture\n"
  },
  "required_files": [
    "src/events.py",
    "docs/events.md",
    "tests/test_events.py"
  ],
  "snapshot_files": [
    "src/events.py",
    "docs/events.md",
    "tests/test_events.py"
  ],
  "assertions": {
    "src/events.py": {
      "contains": ["display_name"],
      "not_contains": ["user_name"]
    },
    "docs/events.md": {
      "contains": ["display_name"],
      "not_contains": ["user_name"]
    },
    "tests/test_events.py": {
      "contains": ["display_name"],
      "not_contains": ["user_name"]
    }
  },
  "executable_checks": [
