{
  "schema_version": 2,
  "task_id": "event-payload-rename",
  "user_prompt": "The user-created event payload changed from user_name to display_name. Synchronize the event producer, event documentation, and tests so the payload contract is consistent.",
  "fixture_files": {
    "src/__init__.py": "",
