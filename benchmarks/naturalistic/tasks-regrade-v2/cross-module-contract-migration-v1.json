{
  "schema_version": 2,
  "task_id": "cross-module-contract-migration-v1",
  "user_prompt": "The user identity field in the event contract is being renamed from id to user_id. Update the producer, consumer, contract documentation, tests, and the compatibility note in docs/decisions/user-id-migration.md so the modules agree on the new contract.",
